#!/bin/sh
# Runs on every commit. Enable once with:
#     git config core.hooksPath .githooks
#
# The split is deliberate. Suite 0 reads the skill itself and always runs: it is
# the only one that catches a drift between the rate reference file and the test
# model, which is exactly the risk when the skill is updated. The other two
# suites check Python code and run only when Python was touched; a change in
# markdown cannot break them and running them then is noise.
#
# Never skip silently: if the environment cannot run a check, the hook says so.
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# --- find an interpreter ---------------------------------------------------
if [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
elif [ -x venv/bin/python ]; then
    PY=venv/bin/python
else
    PY=python3
fi

# --- suite 0: rates in the model against the reference (no dependencies) ---
echo "pre-commit: cross-checking rates against references/stavki.md"
if ! "$PY" test/rates_test.py > /tmp/trz-rates.$$ 2>&1; then
    cat /tmp/trz-rates.$$
    rm -f /tmp/trz-rates.$$
    echo
    echo "Commit stopped: a rate in the reference file has drifted from"
    echo "test/trz_model.py. The reference is the source of truth - fix the model."
    echo "To skip once: git commit --no-verify"
    exit 1
fi
rm -f /tmp/trz-rates.$$
echo "pre-commit: rates match"

# --- packaging: only when the skill or a manifest changed ------------------
if git diff --cached --name-only | grep -qE '^(skills/|\.claude-plugin/|LICENSE)'; then
    if ! "$PY" -c 'import yaml' 2>/dev/null; then
        echo
        echo "pre-commit: the skill or a manifest changed but PyYAML is missing -"
        echo "            the packaging check did NOT run. Create the environment once:"
        echo "              python3 -m venv .venv && .venv/bin/pip install -r test/requirements.txt"
        echo "Commit stopped. Skip: --no-verify"
        exit 1
    fi
    echo "pre-commit: skill or manifest changed - validating packaging"
    if ! "$PY" test/skill_test.py > /tmp/trz-skill.$$ 2>&1; then
        cat /tmp/trz-skill.$$
        rm -f /tmp/trz-skill.$$
        echo
        echo "Commit stopped: the skill would not install cleanly, or the manifests"
        echo "disagree. Skip: git commit --no-verify"
        exit 1
    fi
    rm -f /tmp/trz-skill.$$
    echo "pre-commit: packaging valid"
fi

# --- suites 1, 2 and 3: only when Python changed ---------------------------
if git diff --cached --name-only | grep -q '^test/.*\.py$'; then
    if ! "$PY" -c 'import openpyxl' 2>/dev/null; then
        echo
        echo "pre-commit: Python under test/ was touched but openpyxl is missing -"
        echo "            suites 1, 2 and 3 did NOT run. Create the environment once:"
        echo "              python3 -m venv .venv && .venv/bin/pip install -r test/requirements.txt"
        echo "Commit stopped so that unchecked code does not land. Skip: --no-verify"
        exit 1
    fi
    echo "pre-commit: Python under test/ was touched - running the suites, 25 seeds"
    if ! "$PY" test/run_tests.py --seeds 25 > /tmp/trz-suites.$$ 2>&1; then
        tail -40 /tmp/trz-suites.$$
        rm -f /tmp/trz-suites.$$
        echo
        echo "Commit stopped: the suites fail. To skip: git commit --no-verify"
        exit 1
    fi
    rm -f /tmp/trz-suites.$$
    echo "pre-commit: suites 1, 2 and 3 pass"
fi
