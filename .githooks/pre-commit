#!/bin/sh
# Runs on every commit. Enable once with:
#     git config core.hooksPath .githooks
#
# The split is deliberate. Suite 0 reads the skill itself and always runs: it is
# the only one that catches a drift between the rate reference file and the test
# model, which is exactly the risk when the skill is updated. The other four
# suites (1-4) check Python code and run only when Python was touched; a change
# in markdown cannot break them and running them then is noise.
#
# Never skip silently: if the environment cannot run a check, the hook says so.
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# --- find an interpreter ---------------------------------------------------
if [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
elif [ -x venv/bin/python ]; then
    PY=venv/bin/python
else
    PY=python3
fi

# --- suite 0: rates in the model against the reference (no dependencies) ---
echo "pre-commit: cross-checking rates against references/stavki.md"
if ! "$PY" test/rates_test.py > /tmp/trz-rates.$$ 2>&1; then
    cat /tmp/trz-rates.$$
    rm -f /tmp/trz-rates.$$
    echo
    echo "Commit stopped: a rate in the reference file has drifted from"
    echo "test/trz_model.py. The reference is the source of truth - fix the model."
    echo "To skip once: git commit --no-verify"
    exit 1
fi
rm -f /tmp/trz-rates.$$
echo "pre-commit: rates match"

# --- packaging: only when something skill_test.py asserts against changed ---
# The list is everything that test reads: the skill directory (SKILL.md, the
# references, both plugin manifests, the bundled licence), the marketplace and its
# .github/plugin mirror, the root licences, the READMEs, the social-preview card, and
# the three test files it consults - eval_skill.py for the fixture pin, trz_model.py for
# the scenario count, and itself. The READMEs are here because four of the eight copies
# of the verification date are in them - a badge and a sentence in each; skill_test.py
# checks the source plus all eight, and without README in the list it never ran for the
# commit that broke one. The same goes for the card and the mirror, which were missing
# from an earlier version of this pattern.
PACKAGING='^(skills/|\.claude-plugin/|\.github/plugin/|\.github/social-preview\.html$|LICENSE|README|test/(eval_skill|skill_test|trz_model)\.py$)'
if git diff --cached --name-only | grep -qE "$PACKAGING"; then
    if ! "$PY" -c 'import yaml' 2>/dev/null; then
        echo
        echo "pre-commit: the skill, a manifest, a README or the social card changed but PyYAML"
        echo "            is missing - the packaging check did NOT run. Create the environment once:"
        echo "              python3 -m venv .venv && .venv/bin/pip install -r test/requirements.txt"
        echo "Commit stopped. Skip: --no-verify"
        exit 1
    fi
    echo "pre-commit: skill, manifest, licence, README or social card changed - validating packaging"
    if ! "$PY" test/skill_test.py > /tmp/trz-skill.$$ 2>&1; then
        cat /tmp/trz-skill.$$
        rm -f /tmp/trz-skill.$$
        echo
        echo "Commit stopped: the skill would not install cleanly, or the manifests"
        echo "disagree. Skip: git commit --no-verify"
        exit 1
    fi
    rm -f /tmp/trz-skill.$$
    echo "pre-commit: packaging valid"
fi

# --- all five suites (0-4): only when Python changed ------------------------
# run_tests.py repeats suite 0 and adds the static payroll and the three generated
# suites. There is no personal-data step here: that guard runs in CI, over the text
# files and inside every tracked spreadsheet.
if git diff --cached --name-only | grep -q '^test/.*\.py$'; then
    if ! "$PY" -c 'import openpyxl' 2>/dev/null; then
        echo
        echo "pre-commit: Python under test/ was touched but openpyxl is missing -"
        echo "            the five suites did NOT run. Create the environment once:"
        echo "              python3 -m venv .venv && .venv/bin/pip install -r test/requirements.txt"
        echo "Commit stopped so that unchecked code does not land. Skip: --no-verify"
        exit 1
    fi
    echo "pre-commit: Python under test/ was touched - running all five suites (0-4), 25 seeds"
    if ! "$PY" test/run_tests.py --seeds 25 > /tmp/trz-suites.$$ 2>&1; then
        tail -40 /tmp/trz-suites.$$
        rm -f /tmp/trz-suites.$$
        echo
        echo "Commit stopped: the suites fail. To skip: git commit --no-verify"
        exit 1
    fi
    rm -f /tmp/trz-suites.$$
    echo "pre-commit: all five suites pass"
fi
